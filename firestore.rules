rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Basic helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }
    
    function hasRequiredFields(requiredFields) {
      return request.resource.data.keys().hasAll(requiredFields);
    }
    
    function hasOnlyAllowedFields(allowedFields) {
      return request.resource.data.keys().hasOnly(allowedFields);
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      // Ensure users only write basic info to themselves to prevent escalation
      allow create, update: if isOwner(userId)
        && hasOnlyAllowedFields(['email', 'createdAt', 'theme'])
        && request.resource.data.email is string;
      allow delete: if false; // Prevention of accidental account breakage
    }

    match /sessions/{sessionId} {
      allow read: if isAuthenticated() && resource.data.uid == request.auth.uid;
      
      allow create: if isAuthenticated() 
        && request.resource.data.uid == request.auth.uid
        && hasRequiredFields(['uid', 'title', 'updatedAt', 'messages'])
        && request.resource.data.title is string
        && request.resource.data.messages is list;
        
      // Ensure update doesn't alter ownership uid  
      allow update: if isAuthenticated() 
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.title is string
        && request.resource.data.messages is list;
        
      allow delete: if isAuthenticated() && resource.data.uid == request.auth.uid;
    }

    match /prompts/{promptId} {
      allow read: if isAuthenticated() && resource.data.uid == request.auth.uid;
      
      allow create: if isAuthenticated() 
        && request.resource.data.uid == request.auth.uid
        && hasRequiredFields(['uid', 'title', 'content'])
        && request.resource.data.title is string;
        
      allow update: if isAuthenticated() 
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.title is string;
        
      allow delete: if isAuthenticated() && resource.data.uid == request.auth.uid;
    }
  }
}
